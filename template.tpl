___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// DPOEasy CMP — GTM Custom Template (Sandboxed JavaScript)
// Acionador: Consent Initialization - All Pages

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const getCookieValues = require('getCookieValues');
const gtagSet = require('gtagSet');
const logToConsole = require('logToConsole');
const JSON = require('JSON');

const COOKIE_NAME = 'DPOEasyUserConsent';
const WAIT_FOR_UPDATE = 500;

const ALL_CONSENT_TYPES = [
  'ad_storage',
  'ad_user_data',
  'ad_personalization',
  'analytics_storage',
  'functionality_storage',
  'personalization_storage',
  'security_storage'
];

// Estado padrão: nega tudo que não for essencial.
// Aplicado sempre, antes de qualquer override por região, para que o template
// nunca falhe aberto caso a tabela de estados padrão esteja vazia.
const ALL_DENIED = {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: WAIT_FOR_UPDATE
};

/*
 *   Divide a string de entrada usando vírgula como delimitador, retornando um
 *   array de strings.
 */
const splitInput = (input) => {
  if (!input) return [];
  return input.split(',')
      .map(entry => entry.trim())
      .filter(entry => entry.length !== 0);
};

/*
 *   Processa uma linha da tabela de estados padrão, retornando um objeto que
 *   pode ser passado como argumento para setDefaultConsentState. Retorna
 *   undefined quando a linha não define nenhum tipo de consentimento válido.
 */
const parseCommandData = (settings) => {
  const commandData = {};
  const regions = splitInput(settings['region']);
  if (regions.length > 0) {
    commandData.region = regions;
  }
  let hasType = false;
  splitInput(settings['denied']).forEach(entry => {
    if (ALL_CONSENT_TYPES.indexOf(entry) !== -1) {
      commandData[entry] = 'denied';
      hasType = true;
    }
  });
  splitInput(settings['granted']).forEach(entry => {
    if (ALL_CONSENT_TYPES.indexOf(entry) !== -1) {
      commandData[entry] = 'granted';
      hasType = true;
    }
  });
  if (!hasType) return undefined;
  // wait_for_update (ms) dá tempo de receber as escolhas do visitante via CMP
  commandData.wait_for_update = WAIT_FOR_UPDATE;
  return commandData;
};

/*
 *   Chamado quando há consentimento gravado no cookie.
 *
 *   O cookie DPOEasyUserConsent tem o formato:
 *     {
 *       "consents": {
 *         "mode": "reject_non_essential",
 *         "necessary": [...], "analytics": [], "analytic": [],
 *         "functionality": [], "advertising": [], "marketing": [],
 *         "unknown": [], "others": []
 *       },
 *       "selectedTags": [],
 *       "userConsentToken": "..."
 *     }
 *
 *   Cada categoria é um array dos cookies consentidos naquela categoria — NÃO
 *   são chaves de tipos de consentimento do Google. O banner grava a mesma
 *   categoria sob todos os seus aliases (analytics/analytic,
 *   advertising/marketing, unknown/others). O mapeamento abaixo espelha
 *   CATEGORY_DEFINITIONS em src/config.js do repositório do banner.
 */
const onUserConsent = (cookieValues) => {
  // JSON.parse do sandbox devolve undefined em vez de lançar.
  const cookieObj = JSON.parse(cookieValues[0]);
  if (!cookieObj || !cookieObj.consents) {
    logToConsole('DPOEasy: cookie ' + COOKIE_NAME + ' presente mas ilegível.');
    return;
  }

  const c = cookieObj.consents;
  const acceptedAll = c.mode === 'accept_all';
  const rejectedAll = c.mode === 'reject_non_essential';

  // Modo customizado: categoria concedida quando algum alias tem ao menos um
  // item. O banner só exibe categorias com cookies localizados pelo scanner,
  // então array vazio nunca é ambíguo.
  const granted = (aliases) => {
    if (acceptedAll) return true;
    if (rejectedAll) return false;
    let result = false;
    aliases.forEach(alias => {
      if (c[alias] && c[alias].length > 0) result = true;
    });
    return result;
  };

  const analytics = granted(['analytics', 'analytic']);
  const advertising = granted(['advertising', 'marketing']);
  const functionality = granted(['functionality']);

  updateConsentState({
    analytics_storage:       analytics     ? 'granted' : 'denied',
    ad_storage:              advertising   ? 'granted' : 'denied',
    ad_user_data:            advertising   ? 'granted' : 'denied',
    ad_personalization:      advertising   ? 'granted' : 'denied',
    functionality_storage:   functionality ? 'granted' : 'denied',
    personalization_storage: functionality ? 'granted' : 'denied',
    security_storage: 'granted'
  });
};

/*
 *   Executa o comando de default e, se houver cookie, aplica o consentimento
 *   já registrado pelo visitante.
 */
const main = (data) => {
  gtagSet({
    ads_data_redaction: data.ads_data_redaction === true,
    url_passthrough: data.url_passthrough === true
  });

  // Deny-by-default incondicional.
  setDefaultConsentState(ALL_DENIED);

  // Overrides por região, quando a tabela estiver preenchida.
  if (data.defaultSettings) {
    data.defaultSettings.forEach(settings => {
      const commandData = parseCommandData(settings);
      if (commandData) setDefaultConsentState(commandData);
    });
  }

  const cookieValues = getCookieValues(COOKIE_NAME);
  if (cookieValues && cookieValues.length > 0) {
    onUserConsent(cookieValues);
  }
};

main(data);
data.gtmOnSuccess();


