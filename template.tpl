- name: Tabela de estados padrao adiciona chamada por regiao
  code: |-
    mock('getCookieValues', function() {
      return [];
    });

    let defaults = [];
    mock('setDefaultConsentState', function(state) {
      defaults.push(state);
    });

    runCode({
      defaultSettings: [{
        region: 'BR, PT',
        granted: 'security_storage',
        denied: 'ad_storage, analytics_storage'
      }]
    });

    assertThat(defaults.length).isEqualTo(2);
    assertThat(defaults[1].region).isEqualTo(['BR', 'PT']);
    assertThat(defaults[1].granted).isUndefined();
    assertThat(defaults[1].security_storage).isEqualTo('granted');
    assertThat(defaults[1].ad_storage).isEqualTo('denied');
    assertThat(defaults[1].analytics_storage).isEqualTo('denied');
    assertThat(defaults[1].wait_for_update).isEqualTo(500);
